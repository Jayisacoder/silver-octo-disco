# Document environment variable NAMES only.
# Never commit real secret values.

# Prisma / database
DATABASE_URL=
# Isolated test database connection string — must point at a separate
# database/instance from DATABASE_URL, never the dev or production one.
# Used by the test suite (see docs/agent-handoffs/database.md).
DATABASE_URL_TEST=

# NextAuth / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=

# Optional app settings
NEXT_PUBLIC_APP_NAME=
